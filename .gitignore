def LogoutPage(request):
    logout(request)
    return redirect('home')

@login_required(login_url='login')
def index(request):
    return render(request, 'index.html')

@login_required(login_url='login')
def predictImage(request):
    if request.method == 'POST' and 'filePath' in request.FILES:
        fileObj = request.FILES['filePath']
        fs = FileSystemStorage()
        filePathName = fs.save(fileObj.name, fileObj)
        fileURL = fs.url(filePathName)
        filePath = os.path.join(settings.MEDIA_ROOT, filePathName)

        if not os.path.exists(filePath):
            return HttpResponse("File not found.")

        image = Image.open(filePath).convert('RGB')
        transform = transforms.Compose([
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ])
        image = transform(image).unsqueeze(0).to(device)

        model.eval()
        with torch.no_grad():
            outputs = model(image)
            _, predicted = torch.max(outputs, 1)

        class_names = {0: 'MildDemented', 1: 'ModerateDemented', 2: 'NonDemented', 3: 'Very_Mild_Demented'}
        class_descriptions = {
            'MildDemented': 'Mild cognitive decline with minor memory lapses.',
            'ModerateDemented': 'Significant memory loss and difficulty in daily tasks.',
            'NonDemented': 'No signs of dementia, cognitive functions are normal.',
            'Very_Mild_Demented': 'Pre-dementia stage with slight memory lapses.'
        }

        pred_label = class_names.get(predicted.item(), "Unknown class")
        pred_description = class_descriptions.get(pred_label, 'No description available.')

        return render(request, 'index.html', {'filePathName': fileURL, 'predictedLabel': pred_label, 'description': pred_description})
    
    return render(request, 'index.html')

@login_required(login_url='login')
def upload_audio(request):
    prediction = None  # Default value
    if request.method == "POST" and request.FILES.get('file'):
        audio_file = request.FILES['file']
        file_name = default_storage.save('uploads/' + audio_file.name, ContentFile(audio_file.read()))
        file_path = os.path.join(settings.MEDIA_ROOT, file_name)

        if not os.path.exists(file_path):
            return HttpResponse("Audio file not found.")

        features = extract_features(file_path)
        prediction = "Normal Speech" if clf.predict([features])[0] == 0 else "Alzheimer's Speech"
        
    return render(request, 'upload_audio.html', {"prediction": prediction})

